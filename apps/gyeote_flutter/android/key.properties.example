# android/key.properties 로 복사해 채운다. 이 파일은 커밋하지 않는다 (.gitignore).
# 키 만들기 (한 번만, 잃어버리면 같은 앱으로 업데이트할 수 없다 — Play App Signing 을
# 쓰면 업로드 키는 재설정할 수 있지만 그래도 안전한 곳에 백업한다):
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias upload
storeFile=../upload-keystore.jks
storePassword=바꾼다
keyAlias=upload
keyPassword=바꾼다
