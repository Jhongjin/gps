{
  "expo": {
    "name": "곁에",
    "slug": "gyeote",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gyeote",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gyeote.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "지도에서 내 위치를 확인하고 사용자가 선택한 서클에 위치를 공유하기 위해 위치 권한이 필요합니다.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "장소 도착과 출발 알림, 안전 확인을 위해 앱을 사용하지 않을 때도 위치를 업데이트할 수 있습니다.",
        "NSMotionUsageDescription": "이동 중인지 판단해 배터리 사용을 줄이고 위치 업데이트 정확도를 조절하기 위해 사용합니다."
      }
    },
    "android": {
      "package": "com.gyeote.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-location",
      "expo-notifications",
      "expo-task-manager",
      "expo-background-task",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy",
          "iosAppId": "ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "replace-with-eas-project-id"
      }
    }
  }
}
